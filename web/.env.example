# URL del CSV publicado de la Google Sheet del catálogo
# (Archivo > Compartir > Publicar en la web > formato CSV en la planilla).
# Si no está seteada, el sitio usa el snapshot local de libros.
CATALOG_CSV_URL=

# API key de Google Books (Google Cloud Console > Credenciales), restringida
# a la Books API. Se usa para resolver las portadas reales de los libros.
# Si no está seteada, el catálogo sigue funcionando pero sin portadas.
GOOGLE_BOOKS_API_KEY=
